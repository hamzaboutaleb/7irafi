# Template for infra/docker/.env — copy this file to use the local defaults.
#   cp .env.example .env
# This file IS committed; .env is not. Never put real secrets here.

# Postgres superuser, used both to initialise the cluster and by every service
DB_USERNAME=herafi
DB_PASSWORD=herafi123
# Host port Postgres is published on. Change it if 5432 is already taken on
# your machine; services inside the stack always use postgres:5432.
POSTGRES_HOST_PORT=5432

# Signs and verifies access tokens. Auth service issues them, the gateway
# verifies them — both must hold the identical value or every request 401s.
JWT_SECRET=7irafi-local-example-jwt-signing-secret

# Proves a request came through the gateway rather than straight to a service
GATEWAY_SHARED_SECRET=7irafi-local-example-gateway-secret

# Proves a service-to-service call (auth -> user /internal/**) is trusted
INTERNAL_API_KEY=7irafi-local-example-internal-api-key

# MinIO root credentials. The minio server starts with them, minio-init uses
# them to create the buckets, and job-service and user-service use them as their
# S3 keys. MinIO requires a password of at least 8 characters.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# Automated backups. Interval in seconds, retention in days.
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_DAYS=7

# Metrics tag applied to every Prometheus metric emitted by the services.
APP_ENVIRONMENT=dev

# Credentials Prometheus uses to scrape the gateway's /actuator/prometheus
# (the gateway port is public; every other service is private to the network).
METRICS_USERNAME=prometheus
METRICS_PASSWORD=prometheus123

# How long Prometheus keeps metrics before deleting them (needs a unit: 15d, 48h).
PROMETHEUS_RETENTION=15d

# Local Kafka broker. The host listener is bound to 127.0.0.1.
KAFKA_PORT=9094
# Keep this ID stable while reusing the kafka-data volume.
KAFKA_CLUSTER_ID=l1CSUrkoQ9-RGwZULWZOcQ

# Grafana admin login. Set the credentials in .env. The password is only applied
# when the grafana-data volume is first created: changing it later needs a fresh volume
# or `grafana cli admin reset-admin-password`.
GRAFANA_ADMIN_USER=grafana
GRAFANA_ADMIN_PASSWORD=grafana123

# Elasticsearch superuser password. Kibana and Logstash use dedicated accounts
# (kibana_system / logstash_writer) that es-setup provisions on first boot.
ELASTIC_PASSWORD=elastic123
KIBANA_SYSTEM_PASSWORD=kibana123
LOGSTASH_ES_USER=logstash_writer
LOGSTASH_ES_PASSWORD=logstash123

# Log retention (days). es-setup bakes this into the ILM policy on first boot.
# Development keeps 7; production sets 30.
LOG_RETENTION_DAYS=7
