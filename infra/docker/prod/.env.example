DB_USERNAME=replace-me
DB_PASSWORD=replace-me
POSTGRES_HOST_PORT=5432
JWT_SECRET=replace-me-with-at-least-32-random-characters
GATEWAY_SHARED_SECRET=replace-me
INTERNAL_API_KEY=replace-me
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
METRICS_USERNAME=replace-me
METRICS_PASSWORD=replace-me
# Generate a Kafka cluster ID once and keep it stable while reusing its data.
KAFKA_CLUSTER_ID=replace-me
KAFKA_PORT=9094
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_DAYS=30
APP_ENVIRONMENT=prod
OPENSSL_BIN=openssl

# Set this to the machine IPv4 address reachable by your demo devices.
TLS_HOST_IP=

# Observability settings used by the shared Compose configuration.
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me
ELASTIC_PASSWORD=replace-me
KIBANA_SYSTEM_PASSWORD=replace-me
LOGSTASH_ES_USER=logstash_writer
LOGSTASH_ES_PASSWORD=replace-me
LOG_RETENTION_DAYS=30
