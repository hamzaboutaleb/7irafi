# Copy to infra/docker/prod/.env and replace every placeholder.
# Nginx serves the class project over HTTPS using a self-signed certificate.
# Host ports: HTTP 8088, application HTTPS 8443, media HTTPS 9443.
DB_USERNAME=replace-me
DB_PASSWORD=replace-me
JWT_SECRET=replace-me-with-at-least-32-random-characters
GATEWAY_SHARED_SECRET=replace-me
INTERNAL_API_KEY=replace-me
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
METRICS_USERNAME=replace-me
METRICS_PASSWORD=replace-me
KAFKA_CLUSTER_ID=replace-me
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_DAYS=30
APP_ENVIRONMENT=prod
# Use a reachable IPv4 address, or auto for the host's default network address.
# Keep TLS_HOST_IP and OPENSSL_BIN unquoted, as shown here.
TLS_HOST_IP=auto
# OpenSSL 1.1.1+ is required. On macOS, point this at Homebrew OpenSSL if needed.
OPENSSL_BIN=openssl
# make prod-up generates origins and the certificate fingerprint in .env.https.
