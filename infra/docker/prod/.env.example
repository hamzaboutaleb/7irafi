# Copy to .env to run a local HTTPS demo. Set unique credentials for a deployment.
DB_USERNAME=herafi
DB_PASSWORD=herafi123
POSTGRES_HOST_PORT=5432
JWT_SECRET=7irafi-local-example-jwt-signing-secret
GATEWAY_SHARED_SECRET=7irafi-local-example-gateway-secret
INTERNAL_API_KEY=7irafi-local-example-internal-api-key
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
METRICS_USERNAME=prometheus
METRICS_PASSWORD=prometheus123
# Keep this ID stable while reusing the Kafka volume.
KAFKA_CLUSTER_ID=hvH6cwNLRFSkFHSmYlpDoA
KAFKA_PORT=9094
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_DAYS=30
APP_ENVIRONMENT=prod
OPENSSL_BIN=openssl

# Use the host IPv4 address here when opening the app from another device.
TLS_HOST_IP=127.0.0.1

# Observability settings used by the shared Compose configuration.
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=grafana
GRAFANA_ADMIN_PASSWORD=grafana123
ELASTIC_PASSWORD=elastic123
KIBANA_SYSTEM_PASSWORD=kibana123
LOGSTASH_ES_USER=logstash_writer
LOGSTASH_ES_PASSWORD=logstash123
LOG_RETENTION_DAYS=30
